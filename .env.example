# E-Hentai account cookie (required).
# Copy the Cookie header from a logged-in e-hentai.org session. It must include
# the `event` field; any number works, e.g. event=111.
# The program rewrites this line in place when the site rotates the cookie.
E_COOKIE='ipb_member_id=...; ipb_pass_hash=...; sk=...; event=111'

# Proxy used for check-in requests (optional). Pick one form:
# HTTP:   E_PROXY='http://192.168.50.10:7890'
# SOCKS5: E_PROXY='socks5://192.168.50.10:1080'
E_PROXY=''

# User-Agent override (optional).
E_USER_AGENT=''

# Daily check-in times, local time, ascending. Empty means 00:30,06:30,12:30,18:30.
E_SCHEDULE='00:30,06:30,12:30,18:30'

# Web UI. The password is required when the service starts; pick a long random
# value and keep it out of any public repository.
WEB_PASSWORD=''
WEB_PORT='18391'

# Local file logging is off by default; when enabled it writes LOG_DIR/ehentai.log.
LOG_ENABLED='false'
LOG_DIR='logs'
LOG_MAX_MB='5'
LOG_RETENTION_DAYS='30'
